		)
		(uuid "0aa784bd-0d8a-4ef7-9501-dd08b29cef15")
	)
	(text "Pull-ups on the 32 DATA lines with no fitted mic:\nthe FPGA reads them as a constant 1 (full-scale PCM),\nproving J1/J2 continuity on every DATA pin."
		(exclude_from_sim no)
		(at 83.82 46.228 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "100b5129-714d-47e6-aeaf-4e68175cc5fe")
	)
	(text "Probe points (each with a GND TP within ~5 mm):\nfar end of ARM_02_CLK (longest arm feed) at U99, \nMIC_CLK_72 at its mic (longest populated mic clock), DATA_00 near J1."
		(exclude_from_sim no)
		(at 57.404 162.306 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a4ea598-ed69-43f5-91b0-210fe302f4be")
	)
	(text "+3V6 shunt:\nJ1 side = TP5, regulator side = TP3 (net +3V6_A).\n10 mV per 100 mA."
