(footprint "FT232H_Breakout"
	(version 20260206)
	(generator "pcbnew")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "Adafruit FT232H USB-FIFO breakout, USB-C revision (Adafruit PID 2264, back-compatible board size/mounting-holes/pinout with the earlier micro-USB revision), mounted via 2x11 0.1in sockets -- full physical pinout represented (22 pads: bottom row 3V,5V,GND,D0-D7; top row GND,C9-C0), matching Adafruit's own two 11-pin header strips. Only 13 of the 22 pads are wired in the multi_fpga schematic (D0-D7, and C0-C3 as RXF#/TXE#/RD#/WR# in FT245 sync FIFO mode); the rest (3V out, 5V in, the row-2 GND, C4-C9) are present as real pad positions but intentionally unconnected. Board outline 1.50in x 0.90in and 0.70in row-to-row pin spacing are sourced from Adafruit's own fabrication print (cdn-learn.adafruit.com/downloads/pdf/adafruit-ft232h-breakout.pdf, p.48) -- read off a scanned/rasterized drawing, so treat as best-effort to +/-0.01in, not a vendor-supplied vector dimension; confirm against a physical board before ordering a carrier PCB. Pad size/drill are carried over from the previous approximate footprint (not independently sourced).")
	(tags "FT232H breakout socket USB-C")
	(property "Reference" "REF**"
		(at 0 -14 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "FT232H_Breakout"
