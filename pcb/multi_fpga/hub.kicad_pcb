			(sketchdnponfab yes)
			(crossoutdnponfab yes)
			(subtractmaskfromsilk no)
			(outputformat 5)
			(mirror no)
			(drillshape 0)
			(scaleselection 1)
			(outputdirectory "")
		)
	)
