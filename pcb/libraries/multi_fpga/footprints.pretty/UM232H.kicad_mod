	(pad "J1-12" thru_hole circle (at 7.62 11.43) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask"))
	(pad "J2-13" thru_hole circle (at -7.62 13.97) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask"))
	(pad "J1-13" thru_hole circle (at 7.62 13.97) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask"))
	(pad "J2-14" thru_hole circle (at -7.62 16.51) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask"))
	(pad "J1-14" thru_hole circle (at 7.62 16.51) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask"))
	(embedded_fonts no)
